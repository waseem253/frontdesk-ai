# All optional. With none set: deterministic booking flow + dry-run
# Telegram/SMS + in-memory store → the demo always works.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Real Telegram integration (free bot token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional: force all booking alerts to one chat (else: all who /start the bot)
TELEGRAM_OWNER_CHAT_ID=

# SMS confirmation — Twilio in production (dry-run if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
